<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>NontonVideo - Platform Streaming & Hiburan</title>
    <style>
        /* Reset & Gaya Dasar */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }
        body {
            background-color: #0f1014;
            color: #ffffff;
            line-height: 1.6;
        }
        a {
            text-decoration: none;
            color: inherit;
        }

        /* Header / Navigasi */
        header {
            background-color: #181a20;
            padding: 15px 5%;
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 1px solid #2a2d35;
            position: sticky;
            top: 0;
            z-index: 100;
        }
        .logo {
            font-size: 24px;
            font-weight: bold;
            color: #ff3b30;
        }
        .logo span {
            color: #ffffff;
        }
        nav a {
            margin-left: 20px;
            font-size: 15px;
            color: #b0b3b8;
            transition: 0.3s;
        }
        nav a:hover {
            color: #ffffff;
        }

        /* Kontainer Utama */
        .container {
            max-width: 1200px;
            margin: 20px auto;
            padding: 0 15px;
        }

        /* Slot Iklan (Styling Placeholder) */
        .ad-slot {
            background-color: #1c1e26;
            border: 1px dashed #4a4d57;
            border-radius: 8px;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            text-align: center;
            margin: 20px 0;
            padding: 15px;
            color: #888;
            font-size: 13px;
            overflow: hidden;
        }
        .ad-banner-top {
            min-height: 90px;
            width: 100%;
        }
        .ad-sidebar {
            min-height: 250px;
            width: 100%;
        }

        /* Layout Video + Sidebar */
        .main-grid {
            display: grid;
            grid-template-columns: 2.5fr 1fr;
            gap: 25px;
        }

        /* Pemutar Video Responsif (16:9) */
        .video-wrapper {
            position: relative;
            padding-bottom: 56.25%; /* Rasio 16:9 */
            height: 0;
            overflow: hidden;
            border-radius: 10px;
            background: #000;
            box-shadow: 0 4px 15px rgba(0,0,0,0.5);
        }
        .video-wrapper iframe,
        .video-wrapper video {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            border: none;
        }

        /* Info Video */
        .video-info {
            margin-top: 15px;
            background: #181a20;
            padding: 20px;
            border-radius: 10px;
        }
        .video-title {
            font-size: 22px;
            margin-bottom: 10px;
        }
        .video-meta {
            font-size: 14px;
            color: #888;
            margin-bottom: 15px;
            padding-bottom: 15px;
            border-bottom: 1px solid #2a2d35;
        }

        /* Tombol CTA Affiliate di bawah video */
        .affiliate-cta {
            display: block;
            background: linear-gradient(90deg, #ff5722, #ff9800);
            color: #fff;
            text-align: center;
            padding: 14px;
            border-radius: 8px;
            font-weight: bold;
            font-size: 16px;
            margin-top: 15px;
            transition: transform 0.2s;
        }
        .affiliate-cta:hover {
            transform: scale(1.02);
        }

        /* Sidebar / Daftar Video Lain */
        .sidebar h3 {
            margin-bottom: 15px;
            font-size: 18px;
            border-left: 4px solid #ff3b30;
            padding-left: 10px;
        }
        .video-list-item {
            display: flex;
            gap: 12px;
            margin-bottom: 15px;
            background: #181a20;
            padding: 10px;
            border-radius: 8px;
            transition: 0.3s;
        }
        .video-list-item:hover {
            background: #22252e;
        }
        .thumb {
            width: 120px;
            height: 70px;
            background-color: #2c303a;
            border-radius: 6px;
            object-fit: cover;
            flex-shrink: 0;
        }
        .item-details h4 {
            font-size: 14px;
            margin-bottom: 5px;
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }
        .item-details span {
            font-size: 12px;
            color: #888;
        }

        /* Responsif HP */
        @media (max-width: 768px) {
            .main-grid {
                grid-template-columns: 1fr;
            }
        }
    </style>

